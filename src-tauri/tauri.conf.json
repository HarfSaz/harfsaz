{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Harfsaz",
  "version": "0.1.0",
  "identifier": "com.harfsaz.app",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:3025",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Harfsaz — حرف ساز",
        "width": 1280,
        "height": 860,
        "minWidth": 900,
        "minHeight": 600,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "Productivity",
    "shortDescription": "AI-native Urdu & RTL desktop publishing",
    "longDescription": "Harfsaz is a modern, AI-native desktop publishing app for Urdu, Arabic, Persian, Pashto, Sindhi and Hebrew — with Nastaliq typesetting, 50+ fonts, and built-in AI writing, proofreading and translation.",
    "copyright": "© 2026 Afzaal Ahmad",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "minimumSystemVersion": "10.15",
      "signingIdentity": "-",
      "entitlements": "entitlements.plist"
    },
    "windows": {
      "digestAlgorithm": "sha256",
      "timestampUrl": "http://timestamp.digicert.com",
      "nsis": {
        "installMode": "currentUser",
        "installerIcon": "icons/icon.ico",
        "template": "installer/installer.nsi"
      }
    }
  },
  "plugins": {}
}
