<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <!-- Required for the hardened runtime + notarization. -->
  <!-- Outbound network so the app can reach the AI provider APIs. -->
  <key>com.apple.security.network.client</key>
  <true/>
  <!-- JIT / unsigned memory: WKWebView (the Tauri webview) needs these. -->
  <key>com.apple.security.cs.allow-jit</key>
  <true/>
  <key>com.apple.security.cs.allow-unsigned-executable-memory</key>
  <true/>
  <!-- Allow reading user-selected files (open .harfsaz docs, save PDFs). -->
  <key>com.apple.security.files.user-selected.read-write</key>
  <true/>
</dict>
</plist>
